{
  "name": "@sudobility/testomniac_runner_mcp",
  "version": "0.1.54",
  "description": "MCP server for the Testomniac Runner - gives AI assistants browser control and test execution capabilities",
  "type": "module",
  "license": "BUSL-1.1",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "testomniac-runner-mcp": "./dist/index.js"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun --minify",
    "scan:status": "bun run src/scan-cli.ts",
    "typecheck": "tsc --noEmit",
    "start": "bun run dist/index.js"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@sudobility/testomniac_runner": "^0.0.140",
    "@sudobility/testomniac_runner_service": "^0.1.136",
    "@sudobility/testomniac_types": "^0.0.70",
    "puppeteer": "^25.0.4",
    "zod": "^4.4.3"
  }
}
